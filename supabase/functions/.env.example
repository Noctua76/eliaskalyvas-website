# SERVER ONLY. Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Never put these values in frontend VITE_* variables, Git or request logs.
ALLOWED_ORIGINS=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
RATE_LIMIT_SALT=
# Verify gateway behavior on the selected project before choosing this header/position.
# The rightmost (-1) gateway-injected address is the default; never trust client-supplied first XFF.
TRUSTED_IP_HEADER=
TRUSTED_IP_POSITION=-1
PUBLIC_RATE_LIMIT=5
SLOTS_RATE_LIMIT=60
RESEND_API_KEY=
# A domain-verified sender, set by owner. Recipient routing is fixed in server code.
EMAIL_FROM=
# Full site root INCLUDING GitHub Pages repository path and trailing slash.
PUBLIC_SITE_URL=
# Cryptographically random >=32-character secrets, distinct from each other.
BOOKING_TOKEN_SECRET=
WORKER_SECRET=
# Choose one real calendar only after owner confirmation and OAuth consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
OUTLOOK_TENANT=consumers
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_CALENDAR_ID=
