# INERT REVIEW TEMPLATE. Not an installed GitHub workflow.
name: Website and authorized Signals delivery
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions: {}
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  build-inventory:
    uses: Noctua76/eliaskalyvas-website/.github/workflows/nyra-build.yml@64d848bed447a5d873eb961185a9c7a27610161d
    permissions:
      contents: read
      id-token: write
  inspection:
    needs: build-inventory
    uses: Noctua76/eliaskalyvas-website/.github/workflows/nyra-inspection.yml@REVIEW_REQUIRED_IMMUTABLE_SHA
    permissions:
      contents: read
      id-token: write
  delivery:
    needs: inspection
    # Replace only after separate review with the actual immutable reusable SHA.
    uses: Noctua76/eliaskalyvas-website/.github/workflows/pages-delivery.yml@REVIEW_REQUIRED_IMMUTABLE_SHA
    permissions:
      contents: read
      actions: read
      pages: write
      deployments: write
      id-token: write
